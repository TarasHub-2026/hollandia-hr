PORT=3001
CORS_ORIGIN=https://YOUR_USERNAME.github.io
DB_PATH=./data/hr.db

# Cognito Forms Integration
# API Key: Cognito Forms -> Organization -> Settings -> Integrations -> New API Key
COGNITO_API_KEY=
# Form ID from your embed code (data-form attribute)
COGNITO_FORM_ID=6
# Optional webhook secret — append ?secret=VALUE to your webhook URL in Cognito Forms
COGNITO_WEBHOOK_SECRET=