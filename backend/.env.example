# Copy this file to .env and fill in values

PORT=3001

# Set to your GitHub Pages domain after deployment
# e.g. https://yourusername.github.io or https://yourusername.github.io/hollandia-hr
CORS_ORIGIN=http://localhost:5173

# Path to SQLite database file
# On Railway, mount a Volume to /app/data and set:
DB_PATH=/app/data/hr.db
